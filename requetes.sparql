# Étape 1
# Requête 1 : Les arrondissements les plus filmés

PREFIX dbo: <http://dbpedia.org/ontology/>

SELECT ?arrondissement (COUNT(?tournage) AS ?nbTournages)
WHERE {
  ?tournage a dbo:Event ;
            dbo:place ?lieu .
  ?lieu dbo:postalCode ?cp .
  
  FILTER (STRSTARTS(STR(?cp), "75")) 
  BIND (IF(STR(?cp) = "75116", "75016", STR(?cp)) AS ?arrondissement) 
}
GROUP BY ?arrondissement
ORDER BY DESC(?nbTournages)

# Requête 2 : Tournages de la tour Eiffel
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?nomRealisateur (COUNT(DISTINCT ?cp) AS ?nbArrondissementsExplores) (COUNT(?tournage) AS ?nbTournagesTotal)
WHERE {
  ?tournage dbo:work ?oeuvre ;
            dbo:place ?lieu .
  ?oeuvre dbo:director ?realisateur .
  ?realisateur foaf:name ?nomRealisateur .
  
  # On descend du lieu vers le code postal
  ?lieu dbo:postalCode ?cp .
}
GROUP BY ?nomRealisateur
ORDER BY DESC(?nbArrondissementsExplores)
LIMIT 10
