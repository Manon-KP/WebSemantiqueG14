# Étape 1
# Requête 1 : Les arrondissements les plus filmés

PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbr: <http://dbpedia.org/resource/>

SELECT ?arrondissement (COUNT(?tournage) AS ?nbTournages)
WHERE {
  ?tournage a dbo:Event ;
            dbo:place ?lieu .

  ?lieu dbo:city dbr:Paris ;
        dbo:postalCode ?cp .

  BIND (IF(STR(?cp) = "75116", "75016", STR(?cp)) AS ?arrondissement) 
}
GROUP BY ?arrondissement
ORDER BY DESC(?nbTournages)

# Requête 2 : Moyenne de tournages par an pour chaque genre
PREFIX dbo:    <http://dbpedia.org/ontology/>
PREFIX dbr:    <http://dbpedia.org/resource/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>

SELECT ?nomGenre (AVG(?nbTournagesParAn) AS ?moyenneTournagesParAn)
WHERE {
  # Total des tournages par genre et par année
  {
    SELECT ?genreIRI ?nomGenre ?annee (COUNT(?tournage) AS ?nbTournagesParAn)
    WHERE {
      ?tournage a dbo:Event ;
                dbo:startDate ?debut ;
                schema:about ?oeuvre ;
                dbo:place ?lieu .

      ?lieu dbo:city dbr:Paris .

      ?oeuvre dbo:genre ?genreIRI .
      ?genreIRI rdfs:label ?nomGenre .

      BIND (YEAR(?debut) AS ?annee)
    }
    GROUP BY ?genreIRI ?nomGenre ?annee
  }
}
# Moyenne annuelle par genre
GROUP BY ?genreIRI ?nomGenre
ORDER BY DESC(?moyenneTournagesParAn)
