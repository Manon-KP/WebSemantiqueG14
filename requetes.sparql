# Étape 1
# Requête 1 : Les arrondissements les plus filmés

PREFIX schema: <https://schema.org/>

SELECT ?arrondissement (COUNT(?tournage) AS ?nbTournages)
WHERE {
  ?tournage a schema:Event ;
            schema:location ?lieu .
  ?lieu schema:postalCode ?cp .
  FILTER (STRSTARTS(?cp, "75"))
  BIND (IF(?cp = "75116", "75016", ?cp) AS ?arrondissement) # le 16e a 2 adresses
}
GROUP BY ?arrondissement
ORDER BY DESC(?nbTournages)

# Requête 2 : Tournages de la tour Eiffel
PREFIX schema: <https://schema.org/>
PREFIX geo:    <http://www.w3.org/2003/01/geo/wgs84_pos#>

SELECT ?oeuvre
       (MIN(?titre) AS ?titreOeuvre)
       (COUNT(DISTINCT ?tournage) AS ?nbTournagesAutourEiffel)
WHERE {
  ?tournage schema:location ?lieu ;
            schema:about ?oeuvre .
  ?lieu geo:lat ?lat ;
        geo:long ?long .
  ?oeuvre schema:name ?titre .
  FILTER (?lat > 48.855 && ?lat < 48.862 && ?long > 2.290 && ?long < 2.299)
}
GROUP BY ?oeuvre
ORDER BY DESC(?nbTournagesAutourEiffel)
LIMIT 10

