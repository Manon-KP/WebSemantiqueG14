PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX dbo:     <http://dbpedia.org/ontology/>
PREFIX gn:      <http://www.geonames.org/ontology#>
PREFIX schema:  <https://schema.org/>
PREFIX ex:      <http://example.org/tournages-paris/>
PREFIX apf:     <http://jena.apache.org/ARQ/property#>

CONSTRUCT {
  # Tournage de l'œuvre
  ?tournage a dbo:Event ;
      dcterms:identifier ?a ;
      dbo:place ?lieu ;
      schema:about ?oeuvre ;
      dbo:startDate ?debut ;
      dbo:endDate ?fin .

  # Lieu de tournage
  ?lieu a gn:Feature, dbo:Place ;
      rdfs:label ?adresse ;
      dbo:postalCode ?h ;
      geo:long ?long ;
      geo:lat ?lat ;
      dbo:city ?ville .

  # Oeuvre
  ?oeuvre a ?typeOeuvre ;
      dcterms:title ?titre ;
      dbo:genre ?genreIRI ;
      dbo:director ?realisateur ;
      dbo:producer ?producteur .
  
   ?genreIRI a dbo:Genre ;
      rdfs:label ?genre .

  # Réalisateur
  ?realisateur a foaf:Person ;
      foaf:name ?nomReal .

  # Producteur
  ?producteur a foaf:Organization ;
      foaf:name ?nomProd .
}
WHERE {

  FILTER (REGEX(?a, "^[0-9]{4}-[0-9]+$")) # ignore la ligne d’en-tête

  # IRIs
  BIND (IRI(CONCAT(STR(ex:), "tournage/", ?a)) AS ?tournage)
  BIND (IRI(CONCAT(STR(ex:), "lieu/", ?a)) AS ?lieu)
  BIND (IRI(CONCAT(STR(ex:), "oeuvre/",
        REPLACE(LCASE(?d), "[^\\p{L}\\p{N}]+", "-"))) AS ?oeuvre)  # remplace tout ce qui n'est pas une lettre (\p{L}) ou un chiffre (\p{N}) par un tiret
  BIND (IRI(CONCAT(STR(ex:), "organisation/",
        REPLACE(LCASE(?f), "[^\\p{L}\\p{N}]+", "-"))) AS ?producteur)
   BIND (IRI(CONCAT(STR(ex:), "genre/",
        REPLACE(LCASE(?c), "[^\\p{L}\\p{N}]+", "-"))) AS ?genreIRI)

  # Réalisateurs : plusieurs possibles, parfois vide
  OPTIONAL {
    ?nomBrut apf:strSplit (?e "\\s*(?:/|,|;|\\s+-\\s+|\\s+[eE][tT]\\s+)\\s*") . # sépare les noms des réalisateurs
    
    # nettoie le(s) nom(s)
    BIND (REPLACE(STR(?nomBrut), "\\s+", " ") AS ?nomPropre)
    FILTER (?nomPropre != "")
    BIND (UCASE(?nomPropre) AS ?nomReal)
    
    # IRI
    BIND (IRI(CONCAT(STR(ex:), "personne/", REPLACE(LCASE(?nomPropre), "[^\\p{L}\\p{N}]+", "-"))) AS ?realisateur)
  }

  # Villes : Paris ou communes de banlieue spécifiques
  BIND (
    IF(STRSTARTS(STR(?h), "75"), IRI("http://dbpedia.org/resource/Paris"),
    IF(STR(?h) = "94320", IRI("http://dbpedia.org/resource/Thiais"),
    IF(STR(?h) = "93500", IRI("http://dbpedia.org/resource/Pantin"),
    IF(STR(?h) = "93320", IRI("http://dbpedia.org/resource/Les_Pavillons-sous-Bois"),
    IF(STR(?h) = "92220", IRI("http://dbpedia.org/resource/Bagneux,_Hauts-de-Seine"),
    IF(STR(?h) = "92170", IRI("http://dbpedia.org/resource/Vanves"),
    ?absent)))))) AS ?ville
  )

  # Littéraux typés
  BIND (STRLANG(?d, "fr") AS ?titre)
  BIND (STRLANG(?c, "fr") AS ?genre)
  BIND (STRLANG(REPLACE(STR(?g), "[\\s\u00A0]+", " "), "fr") AS ?adresse) # remplace toute suite d’espaces ou d’espaces insécables par un seul espace normal
  BIND (STR(?f) AS ?nomProd)
  BIND (STRDT(?i, xsd:date) AS ?debut)
  BIND (STRDT(?j, xsd:date) AS ?fin)
  BIND (STRDT(?k, xsd:decimal) AS ?long)
  BIND (STRDT(?l, xsd:decimal) AS ?lat)

  # Type de l'œuvre
  BIND (
    IF(CONTAINS(?c, "Web"), dbo:Work, # Série Web
    IF(CONTAINS(?c, "Série") || CONTAINS(?c, "Téléfilm"), dbo:TelevisionShow, # Série TV et Téléfilm
    dbo:Film)) AS ?typeOeuvre # Long métrage
  )
}